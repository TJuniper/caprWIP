@article{Versloot2025,
  author  = {Versloot, Arjen P.},
  title   = {Reconstructing the Historical Phonology of {Old} {English}},
  journal = {English Language and Linguistics},
  year    = {2025},
  volume  = {30},
  number  = {1},
  pages   = {103--141},
  doi     = {10.1017/S1360674324000674},
  file    = {docs/references/versloot_2025_reconstructing_historical_phonology_of_oe.txt},
  note    = {Open Access (CC BY-NC 4.0). Proposes a substantially simplified
             alternative to the ``Standard Theory'' chronology of pre-Old
             English, in which PGmc\ *a is the target of eight separate sound
             laws. Versloot replaces these with a conditional early fronting
             and rounding, a gradual i-mutation effect, and a comparatively
             late seventh-century breaking before -rC, each claimed to have a
             Frisian parallel. Tested chiefly against the early
             \'Epinal and Erfurt glossaries. Directly relevant to the
             Anglo-Frisian chronology problem because it argues the English
             and Frisian developments are parallel in structure; see
             Germanic/docs/sound\_changes/literature\_dossiers/anglo\_frisian/.
             Research state only: CAPR has not adjudicated it against the
             Standard Theory that the executable cascade currently encodes.}
}

