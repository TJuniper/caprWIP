# FST compiled binaries (regenerated from .txt sources).
# NO .bin files are tracked: bins are runtime artifacts rebuilt into the
# authoritative bin directory (host: backend/; container: /usr/app) by
# Germanic/tools/rebuild_oe_bins.sh or adjudicate.py --evidence, and their
# freshness is recorded in backend/oe_build_manifest.json.
/Germanic/fsts/*.bin
/backend/oe_build_manifest.json
# Reference PDFs are not committed (kept local; .txt extracts are committed)
# Temporary/sandbox files
docs/references/*.pdf

# OCR cache
.cache/

# LaTeX/XeLaTeX build artifacts — not canonical tracked outputs
texput.log
*.aux
*.log
*.toc
# .idx/.ind/.ilg are intermediate MakeIndex files deleted by build_capr_book_draft_docker.sh
# Allowing them here is belt-and-suspenders for dev environments
Germanic/docs/assembly/*.idx
Germanic/docs/assembly/*.ind
Germanic/docs/assembly/*.ilg
Germanic/docs/assembly/*.pre_locator.tex
